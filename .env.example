# Bittensor RPC endpoint.
# Testnet (default): wss://test.finney.opentensor.ai:443
# Mainnet:           wss://entrypoint-finney.opentensor.ai:443
BITTENSOR_RPC_URL=wss://test.finney.opentensor.ai:443

# Domain shown in the signed message. Set this to your real domain in production.
APP_DOMAIN=localhost:3000

# How long a challenge stays valid, in seconds.
CHALLENGE_TTL_SECONDS=300

# Where votes are stored (SQLite file). Default: data/votes.sqlite
# VOTES_DB_PATH=data/votes.sqlite
